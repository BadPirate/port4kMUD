
# Discord bridge (all optional - the bridge stays off with DISCORD_BOT_TOKEN unset)
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=
# DISCORD_BRIDGE_SOCKET_PATH=/tmp/port4k-discord.sock
# DISCORD_BOT_MUD_USERNAME=
# DISCORD_BOT_MUD_PASSWORD=
#
# NOTE: DISCORD_BOT_MUD_USERNAME and DISCORD_BRIDGE_SOCKET_PATH are also read
# directly by the MUD binary (mud/src/discord.c via getenv()). Setting them
# only here (server/.env.local, loaded by dotenv into the Node process) is
# invisible to bin/circle - export them in your actual shell/container
# environment too, e.g. via a top-level .env sourced before launch.sh starts
# the MUD, or as container-level env vars in production (Coolify, Dokku, etc).
