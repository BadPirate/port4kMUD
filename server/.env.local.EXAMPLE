# Portal accounts (email sign-in and the character list)
#
# BETTER_AUTH_SECRET signs session cookies AND encrypts the MUD passwords the
# bridge replays at the game's password prompt. It is required in production.
# Generate one with: openssl rand -base64 32
# Changing it signs everyone out and makes every saved character password
# unreadable, so each character has to be entered again.
# BETTER_AUTH_SECRET=

# Only needed when the public URL is not the host the browser asked for, as
# behind a reverse proxy. Magic links are built from it.
# BETTER_AUTH_URL=https://mud.example.com

# Where the accounts database lives. The default is mud/lib/etc/portal.sqlite,
# inside the directory a deployment already mounts for persistence.
# AUTH_DATABASE_PATH=

# Shown in the navbar. Without it the page shows "telnet <host> 4000".
# SITE_TITLE=Port 4000

# How many characters one account may keep (default 5).
# MAX_CHARACTER_LIMIT=5

# How long a magic link stays usable, in seconds (default 900).
# MAGIC_LINK_TTL_SECONDS=900

# Outbound mail for magic links. Without SMTP_HOST no mail is sent: in
# development the link is printed to the console, and in production sign-in
# fails rather than silently dropping the mail.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Discord bridge (all optional - the bridge stays off with DISCORD_BOT_TOKEN unset)
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=
# DISCORD_BRIDGE_SOCKET_PATH=/tmp/port4k-discord.sock
# DISCORD_BOT_MUD_USERNAME=
# DISCORD_BOT_MUD_PASSWORD=
#
# NOTE: DISCORD_BOT_MUD_USERNAME and DISCORD_BRIDGE_SOCKET_PATH are also read
# directly by the MUD binary (mud/src/discord.c via getenv()). Setting them
# only here (server/.env.local, loaded by dotenv into the Node process) is
# invisible to bin/circle - export them in your actual shell/container
# environment too, e.g. via a top-level .env sourced before launch.sh starts
# the MUD, or as container-level env vars in production (Coolify, Dokku, etc).
