{
  "name": "Port4k",
  "version": "2025.5.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "prisma generate && next build && tsc --project tsconfig.server.json",
    "dev": "prisma generate && prisma migrate deploy && ts-node --project tsconfig.server.json server.ts",
    "lint": "echo '\\n=== RUNNING PRETTIER ===\\n' && prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css,scss,html}\" && echo '\\n=== RUNNING ESLINT ===\\n' && eslint . --fix --max-warnings=0 && echo '\\n=== RUNNING TYPESCRIPT TYPE CHECK ===\\n' && tsc --noEmit || (echo '\\n⚠️  Linting or type-checking failed. Please fix errors before committing.\\n' && exit 1)",
    "prepare": "husky",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "start": "NODE_ENV=production node dist/server.js",
    "test": "jest --passWithNoTests",
    "test:e2e": "NODE_ENV=test playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "better-auth": "1.7.5",
    "bootstrap": "^5.3.2",
    "discord.js": "^14.27.0",
    "dotenv": "^16.5.0",
    "next": "^16.3.5",
    "nodemailer": "^10",
    "react": "^19.3.0",
    "react-bootstrap": "^2.8.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "telnet-client": "^2.2.5",
    "ts-node": "^10.9.1"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@playwright/test": "^1.52.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sha256": "^0.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "get-port": "^7.1.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "prisma": "7.10.0",
    "ts-jest": "^29.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "whatwg-fetch": "^3.6.20"
  },
  "resolutions": {
    "postcss": "^8.5.23"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,md,css,scss,html}": [
      "prettier --write"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=22.18"
  }
}
